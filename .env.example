# Local dev defaults. Copy to .env for development.
# Production values belong in the hosting environment, not this file.
# Set DATABASE_URL to a PostgreSQL URL, or AIVEN_DATABASE_URI for Aiven.
DATABASE_URL=
AIVEN_DATABASE_URI=
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080
JWT_ISSUER=signal-clone
CORS_ORIGINS=http://localhost:3000
IMAGEKIT_PRIVATE_KEY=
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_EMAIL_CONTINUE_URL=http://localhost:3000/auth/email-link
