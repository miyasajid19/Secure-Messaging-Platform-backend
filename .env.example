# Local dev defaults. Copy to .env for development.
# Production values are set in Railway's service env vars (NOT in this file).
# Required for prod: JWT_SECRET=<random>; CORS_ORIGINS=<frontend-URL>; DATABASE_URL=sqlite:////data/app.db
DATABASE_URL=sqlite:///./app.db
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080
JWT_ISSUER=signal-clone
CORS_ORIGINS=http://localhost:3000
IMAGEKIT_PRIVATE_KEY=